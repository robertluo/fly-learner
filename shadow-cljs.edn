{:deps {:aliases [:cljs]}

 :dev-http {8280 "resources/public"}

 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn learner.app/init}}
        :devtools {:after-load learner.app/reload}}

  :test {:target :node-test
         :output-to "target/cljs-test/test.js"
         :ns-regexp "-test$"
         :autorun true}}}
