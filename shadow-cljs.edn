{:deps {:aliases [:cljs]}

 ;; frontend on :3000, /api and /files proxied to the backend on :8080
 :dev-http {3000 {:root "resources/public"
                  :proxy-url "http://localhost:8080"}}

 :nrepl {:port 0}

 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:entries [learner.ui.core]}}
        :devtools {:after-load learner.ui.core/render!}}}}
