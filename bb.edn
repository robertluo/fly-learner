{:paths ["bb"]
 :tasks
 {:requires ([babashka.fs :as fs])

  vendor
  {:doc "Copy the pdf.js bundle and worker, and KaTeX's stylesheet and fonts, from node_modules into resources/public/vendor"
   :task (let [src  "node_modules/pdfjs-dist/build"
               dest "resources/public/vendor/pdfjs"]
           (fs/create-dirs dest)
           (doseq [f ["pdf.min.mjs" "pdf.worker.min.mjs"]]
             (fs/copy (fs/path src f) dest {:replace-existing true}))
           ;; formulas: the script is bundled from npm by shadow-cljs; its css and fonts are served
           (fs/create-dirs "resources/public/vendor/katex")
           (fs/copy "node_modules/katex/dist/katex.min.css" "resources/public/vendor/katex" {:replace-existing true})
           (fs/copy-tree "node_modules/katex/dist/fonts" "resources/public/vendor/katex/fonts" {:replace-existing true}))}

  install
  {:doc "Install npm packages from package-lock.json, then vendor pdf.js and KaTeX"
   :task (do (shell "npm ci") (run 'vendor))}

  dev
  {:doc "nREPL for backend + frontend (writes .nrepl-port). In the REPL:
         (user/cljs!) starts the backend on :8080 and shadow-cljs on :3000"
   :depends [install]
   ;; piggieback's middleware is listed because shadow's and cider's declare it;
   ;; shadow's runs first and handles the cljs REPL itself
   :task (clojure "-M:dev:cljs -m nrepl.cmdline --middleware"
                  "[shadow.cljs.devtools.server.nrepl/middleware,cider.nrepl/cider-middleware,cider.piggieback/wrap-cljs-repl]")}

  ingest
  {:doc "Ingest PDFs: bb ingest data/sources/<file>.pdf ... Folds each with Claude, then
         resolves new keywords into concepts. Runs inside the dev REPL when one is up
         (the running app's db; only one process may write it), else in a new JVM"
   :requires ([ingest-task])
   :task (ingest-task/run *command-line-args*)}

  watch
  {:doc "shadow-cljs watch without a REPL (http://localhost:3000)"
   :depends [install]
   :task (shell "npx shadow-cljs watch app")}

  serve
  {:doc "Run the backend server (:8080) serving the release frontend"
   :depends [install]
   :task (do (shell "npx shadow-cljs release app")
             (clojure "-M:run"))}

  test
  {:doc "Run tests (Kaocha: clojure.test + Rich Comment Tests)"
   :task (apply clojure "-M:dev:kaocha" *command-line-args*)}

  lint
  {:doc "Lint with clj-kondo"
   :task (shell "clj-kondo --lint src test dev")}

  clean
  {:doc "Remove build output and caches"
   :task (doseq [d [".cpcache" ".shadow-cljs" "target" "resources/public/js"]]
           (fs/delete-tree d))}}}
