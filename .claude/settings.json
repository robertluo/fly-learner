{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.devenv/profile/bin/clj-paren-repair-claude-hook --cljfmt" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.devenv/profile/bin/clj-paren-repair-claude-hook --cljfmt" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.devenv/profile/bin/clj-paren-repair-claude-hook --cljfmt" }
        ]
      }
    ]
  }
}
